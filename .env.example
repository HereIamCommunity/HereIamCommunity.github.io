# 코이노니아 웹 환경변수 예시
# 이 파일을 .env.local 로 복사해서 값을 채운다. 실제 값은 커밋하지 않는다.
# Vercel 배포는 Project > Settings > Environment Variables 에 Production/Preview 양쪽 입력.

# ─── 어드민 ────────────────────────────────────────
ADMIN_PASSWORD=

# ─── 솔라피 (알림톡 + 문자) ────────────────────────
# 콘솔 > API Key 관리
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 콘솔 > 발신번호 관리에서 등록·인증한 번호 (하이픈 없이)
SOLAPI_SENDER_PHONE=
# 호스트(운영자) 수신번호 (하이픈 없이)
OPERATOR_PHONE=

# ─── 카카오 알림톡 ─────────────────────────────────
# 콘솔 > 카카오 채널 관리에서 연동 후 발급되는 pfId
KAKAO_PFID=
# 알림톡 템플릿 ID (docs/alimtalk-templates.md 문안으로 등록 → 검수 승인 후 입력)
# 비워두면 해당 알림은 발송되지 않는다 (템플릿 검수 전 상태). 문자는 알림톡 실패 시 대체로만 나간다.
KAKAO_TEMPLATE_SALON_RECEIVED=
KAKAO_TEMPLATE_STAY_RECEIVED=
KAKAO_TEMPLATE_SALON_CONFIRMED=
KAKAO_TEMPLATE_STAY_CONFIRMED=
KAKAO_TEMPLATE_CANCELLED=
KAKAO_TEMPLATE_HOST=

# ─── 구글 시트 ─────────────────────────────────────
GOOGLE_SHEET_ID=
# 서비스 계정 JSON 전체를 한 줄로 (개행 없이)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── 이메일 (Resend) ───────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPERATOR_EMAIL=

# ─── 토스페이먼츠 ──────────────────────────────────
TOSS_SECRET_KEY=

# ─── 에어비앤비 iCal (객실별 예약 동기화) ──────────
AIRBNB_ICAL_NAGNAE=
AIRBNB_ICAL_OKSUN=
AIRBNB_ICAL_YEUTAE=

# ─── Cron (Vercel Cron 호출 인증) ──────────────────
CRON_SECRET=
