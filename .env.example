# 코이노니아 웹 환경변수 예시
# 이 파일을 .env.local 로 복사해서 값을 채운다. 실제 값은 커밋하지 않는다.
# Vercel 배포는 Project > Settings > Environment Variables 에 Production/Preview 양쪽 입력.

# ─── 어드민 ────────────────────────────────────────
ADMIN_PASSWORD=

# ─── 솔라피 (알림톡 + 문자) ────────────────────────
# 콘솔 > API Key 관리
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 콘솔 > 발신번호 관리에서 등록·인증한 번호 (하이픈 없이)
SOLAPI_SENDER_PHONE=
# 호스트(운영자) 수신번호 (하이픈 없이)
OPERATOR_PHONE=

# ─── 카카오 알림톡 ─────────────────────────────────
# 콘솔 > 카카오 채널 관리에서 연동 후 발급되는 pfId
# 값: KA01PF260906102131362qstrcMe7MZW
KAKAO_PFID=
# 알림톡 템플릿 ID 8개 (docs/alimtalk-templates.md · 검수 승인 후 아래 주석의 값을 넣는다)
# 게스트 알림(1~6): 비워두면 그 알림은 발송되지 않는다. 문자는 알림톡 실패 시 대체로만 나간다.
# cron 안내(7~8): 비워두면 같은 문안이 문자로 나간다 (운영 중이라 끊지 않는다).
# 1. [살롱] 신청 접수 시     KA01TP260906111616282uwVQwrob8OX
KAKAO_TEMPLATE_SALON_RECEIVED=
# 2. [살롱] 입금 확인 후     KA01TP260906111937411oOGf3DvHzvk
KAKAO_TEMPLATE_SALON_CONFIRMED=
# 3. [살롱] 취소 시          KA01TP260906112315549mUsVO3mwUOp
KAKAO_TEMPLATE_SALON_CANCELLED=
# 4. [스테이] 예약 신청 접수 시  KA01TP260906113200151llfNLykPo8D
KAKAO_TEMPLATE_STAY_RECEIVED=
# 5. [스테이] 입금 확인 후      KA01TP260906113427164x8hMIBrOnlo
KAKAO_TEMPLATE_STAY_CONFIRMED=
# 6. [스테이] 취소 시           KA01TP260906145135509OW6gQGoG34u
KAKAO_TEMPLATE_STAY_CANCELLED=
# 7. [스테이] 체크인 전날 D-1   KA01TP2609061459009997cIwUSazlQn
KAKAO_TEMPLATE_STAY_REMINDER=
# 8. [스테이] 체크아웃 당일     KA01TP2609061500047704yNnPWcl2KG
KAKAO_TEMPLATE_STAY_CHECKOUT=
# (선택) 호스트 알림 템플릿. 미등록이라 비워둔다 — 호스트에게는 문자로 나간다.
KAKAO_TEMPLATE_HOST=

# ─── 슬랙 봇 (호스트 알림) ─────────────────────────
# 호스트(운영자) 알림을 슬랙 채널로 보낸다. 둘 중 하나라도 비면 기존 호스트 문자로 나간다.
# api.slack.com/apps > Create New App(From scratch) > OAuth & Permissions
#   > Bot Token Scopes에 chat:write 추가 > Install to Workspace
#   > Bot User OAuth Token(xoxb-…) 복사
SLACK_BOT_TOKEN=
# 알림 받을 채널에서 /invite @봇이름 을 먼저 하고, 채널 상세 하단의 채널 ID(C0…)를 복사
SLACK_CHANNEL_ID=

# ─── 구글 시트 ─────────────────────────────────────
GOOGLE_SHEET_ID=
# 서비스 계정 JSON 전체를 한 줄로 (개행 없이)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── 이메일 (Resend) ───────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPERATOR_EMAIL=

# ─── 토스페이먼츠 ──────────────────────────────────
TOSS_SECRET_KEY=

# ─── 에어비앤비 iCal (객실별 예약 동기화) ──────────
AIRBNB_ICAL_NAGNAE=
AIRBNB_ICAL_OKSUN=
AIRBNB_ICAL_YEUTAE=

# ─── Cron (Vercel Cron 호출 인증) ──────────────────
CRON_SECRET=
